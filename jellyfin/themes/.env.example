# Copy this file to .env (git ignores it) and fill in the key.
# Jellyfin API key for ship.sh's "who is watching" check:
#   Jellyfin Dashboard > API Keys > + (name it e.g. ship-theme)
JELLYFIN_API_KEY=

# Optional: how this PC reaches Jellyfin (this is the default)
# JELLYFIN_URL=https://jellyfin.local.starklab.mkroshana.com
